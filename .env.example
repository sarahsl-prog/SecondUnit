# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-exp

# Grafana Cloud
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_API_KEY=your-grafana-api-key

# GCP
GCP_PROJECT_ID=your-project-id
GCP_ZONE=us-central1-a

# Service URLs (local)
BRAIN_SERVICE_URL=http://brain:8080
HANDS_SERVICE_URL=http://hands:8080
SIMULATOR_URL=http://simulator:8080

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Cloud Scheduler -> Brain /sentry/poll auth (optional; unset = unauthenticated,
# fine for local/demo — see docs/Code-review-to-do.md #5/#7)
SCHEDULER_TOKEN=
POLL_COOLDOWN_SECONDS=300

# Quartermaster nightly-spend tracking (single-instance demo persistence;
# Cloud Run's /tmp is writable but ephemeral per instance)
BUDGET_STATE_PATH=/tmp/secondunit-budget-state.json

# Quartermaster -> Hands retry backoff base (seconds); doubles each of the
# 3 attempts (design spec §3.3)
HANDS_RETRY_BACKOFF_SECONDS=1.0
