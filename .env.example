# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-exp

# Grafana Cloud — used by both Brain (GrafanaMCPClient, review #18) and
# the Simulator (LogEmitter's Loki push, review #19). When set,
# GrafanaMCPClient makes real HTTP calls (assumes a Prometheus-compatible
# query endpoint at {GRAFANA_URL}/api/v1/query and Loki push at
# {GRAFANA_URL}/loki/api/v1/push — verify both match your stack). Leave
# unset for local/demo: falls back to built-in mock data / no-ops with no
# live Grafana stack required. Metrics are pull-based instead — scrape
# GET /simulator/metrics from a local Prometheus/Grafana Agent.
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_API_KEY=your-grafana-api-key

# GCP
GCP_PROJECT_ID=your-project-id
GCP_ZONE=us-central1-a
# GCPComputeClient is still a stub (no real GCP SDK calls implemented) —
# this flag exists so a real implementation defaults to dry-run and must
# be explicitly enabled for demo day, not left on by an unattended poll loop.
ENABLE_REAL_GCP_ACTIONS=false

# Service URLs (local)
BRAIN_SERVICE_URL=http://brain:8080
HANDS_SERVICE_URL=http://hands:8080
SIMULATOR_URL=http://simulator:8080

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Cloud Scheduler -> Brain /sentry/poll auth (optional; unset = unauthenticated,
# fine for local/demo — see docs/Code-review-to-do.md #5/#7)
SCHEDULER_TOKEN=
POLL_COOLDOWN_SECONDS=300

# Quartermaster nightly-spend tracking (single-instance demo persistence;
# Cloud Run's /tmp is writable but ephemeral per instance)
BUDGET_STATE_PATH=/tmp/secondunit-budget-state.json

# Quartermaster -> Hands retry backoff base (seconds); doubles each of the
# 3 attempts (design spec §3.3)
HANDS_RETRY_BACKOFF_SECONDS=1.0

# Guaranteed local fallback when Slack and Grafana are both unconfigured
# or both fail — a remediation must never go completely unnotified
DISPATCHER_FALLBACK_PATH=/tmp/secondunit-unnotified-incidents.jsonl
